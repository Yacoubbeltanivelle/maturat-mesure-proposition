# Publication explicite : aucun document de travail, aperçu ni sauvegarde.
/*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/index.html
!/styles.css
!/admin.css
!/data.js
!/app.js
!/js/
/js/*
!/js/admin.js
!/js/dom.js
!/js/layout.js
!/js/pages.js
!/js/request.js
!/js/router.js
!/js/state.js
!/scripts/
/scripts/*
!/scripts/check.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/verification.yml
!/assets/
/assets/*
!/assets/maturat-logo.png
!/assets/hero-blue-grain.png
!/assets/surface-grain.svg
!/assets/product-atlas.png
!/assets/CREDITS-MEDIA.md
!/assets/documents/
/assets/documents/*
!/assets/documents/fiche-demonstration.pdf
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/instrument-sans-400.ttf
!/assets/fonts/instrument-sans-500.ttf
!/assets/fonts/instrument-sans-600.ttf
!/assets/fonts/OFL.txt
!/assets/fonts/NOTICES.txt
!/assets/photos/
/assets/photos/*
!/assets/photos/industrial-pipes.jpg
!/assets/photos/industrial-blue.jpg
