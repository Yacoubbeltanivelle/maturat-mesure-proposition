# Publication explicite : aucun document de travail ni sauvegarde.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/styles.css
!/data.js
!/app.js
!/assets/
/assets/*
!/assets/maturat-logo.png
!/assets/hero-blue-grain.png
!/assets/surface-grain.svg
!/assets/dropout-cutout.png
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/instrument-sans-400.ttf
!/assets/fonts/instrument-sans-500.ttf
!/assets/fonts/instrument-sans-600.ttf
!/assets/fonts/OFL.txt
!/assets/fonts/NOTICES.txt
!/assets/photos/
/assets/photos/*
!/assets/photos/home-level-houdec.png
!/assets/photos/home-flow-fuji.png
!/assets/photos/home-temperature-fuji.png
!/assets/photos/home-pressure-fuji.png
